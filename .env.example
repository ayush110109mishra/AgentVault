# ==============================================================================
# AgentVault X — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Open-Weight Model Provider (Recommended: Google Gemma 2)
# ------------------------------------------------------------------------------
# Option A: Local Ollama (Runs Gemma 2 locally on GPU/CPU without API keys)
# To use: install Ollama from https://ollama.com and run: ollama run gemma2:9b
MODEL_PROVIDER="ollama"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="gemma2:9b"

# Option B: Hosted Open-Weight Endpoint (e.g. Groq, vLLM, Hugging Face, OpenRouter)
# MODEL_PROVIDER="open-weight"
# OPEN_WEIGHT_API_URL="https://api.groq.com/openai/v1"
# OPEN_WEIGHT_API_KEY="your-hosted-inference-key"
# OPEN_WEIGHT_MODEL="gemma2-9b-it"

# ------------------------------------------------------------------------------
# 2. Optional Secondary Provider: Google Gemini
# ------------------------------------------------------------------------------
# GEMINI_API_KEY="your-gemini-api-key"

# ------------------------------------------------------------------------------
# 3. Server Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV="development"
